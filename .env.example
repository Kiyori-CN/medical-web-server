# Non-secret local development template.
# Copy to .env.local and adjust local paths. Do not commit .env.local.

FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=8080
FLASK_DEBUG=false
CORS_ORIGINS=http://127.0.0.1:8080

# v1 compatibility. Point this only at a prepared legacy index when testing v1.
KB_PATH=./knowledge-base/legacy/西医题库
LEGACY_SEARCH_ENABLED=false
DEFAULT_TOP_K=10
DEFAULT_THRESHOLD=0.3
MAX_WORKERS=4
TIMEOUT=120

# v2 local data contract.
SOURCE_DATA_ROOT=./data
KNOWLEDGE_BASE_ROOT=./knowledge-base/v2
# Leave empty to resolve KNOWLEDGE_BASE_ROOT/current.json. Set only for an
# explicit one-off build override.
CATALOG_DB=
PRACTICE_DB=./state/practice.sqlite3
SETTINGS_DB=./state/settings.sqlite3
SETTINGS_KEY_PATH=./state/settings.key
# Required to modify provider settings through the website. Use a long random
# value in production; never commit the real token.
ADMIN_TOKEN=
PROVIDER_TIMEOUT=60

# v2 provider URLs, models, dimensions and encrypted API keys are managed by
# the administrator settings page and stored under SETTINGS_DB/SETTINGS_KEY_PATH.
# Do not put real provider keys in this template.

# Limit per-worker BLAS threads on a 4-core server. The vector matrix is mmap'd
# and shared by the operating-system page cache across Gunicorn workers.
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
