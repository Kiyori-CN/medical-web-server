# Non-secret template. Copy to .env.local if needed; never commit .env.local.

FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=true
SECURE_COOKIES=false
CORS_ORIGINS=

# Local read-only catalog and writable state.
SOURCE_DATA_ROOT=./data
KNOWLEDGE_BASE_ROOT=./knowledge-base
# Leave empty to resolve KNOWLEDGE_BASE_ROOT/current.json.
CATALOG_DB=
APP_DB=./state/app.sqlite3
SETTINGS_DB=./state/settings.sqlite3
SETTINGS_KEY_PATH=./state/settings.key
PROVIDER_TIMEOUT=60

# Provider URLs, models and encrypted API keys are managed by an administrator
# through the website. Never place real provider keys in this file.

# Production 4-core / 4-GB thread limits.
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
