# Non-secret local development template.
# Copy to .env.local and adjust local paths. Do not commit .env.local.

FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=8080
FLASK_DEBUG=false
CORS_ORIGINS=http://127.0.0.1:8080

# v1 compatibility. Point this only at a prepared legacy index when testing v1.
KB_PATH=./knowledge-base/legacy/西医题库
LEGACY_SEARCH_ENABLED=false
DEFAULT_TOP_K=10
DEFAULT_THRESHOLD=0.3
MAX_WORKERS=4
TIMEOUT=120

# v2 local data contract.
SOURCE_DATA_ROOT=./data
KNOWLEDGE_BASE_ROOT=./knowledge-base/v2
# Leave empty to resolve KNOWLEDGE_BASE_ROOT/current.json. Set only for an
# explicit one-off build override.
CATALOG_DB=
PRACTICE_DB=./state/practice.sqlite3
SEMANTIC_SEARCH_ENABLED=false

# Semantic search must be optional and local-first. A future local model path can
# be configured here; no remote provider or API key is required by the core app.
LOCAL_EMBED_MODEL_PATH=
